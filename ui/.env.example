# Copy to .env.local. Next.js loads it automatically.
NEXT_PUBLIC_APP_NAME="3 Days in Italy"
NEXT_PUBLIC_APP_DESCRIPTION="Plan a trip, then make it your own."

# Local: uv run langgraph dev (run from agent/).
LANGGRAPH_API_URL=http://127.0.0.1:2024
LANGGRAPH_ASSISTANT_ID=italy_agent
# Set for a hosted LangGraph deployment. Never use NEXT_PUBLIC_ for this key.
LANGGRAPH_API_KEY=

# Required. Use a long, random shared password before exposing the app.
TEST_AUTH_PASSWORD=
# Optional; leave empty for a password-only login.
TEST_AUTH_USERNAME=
MAX_MESSAGE_LENGTH=10000
RATE_LIMIT_PER_MINUTE=20
